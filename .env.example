# ResponseOS Environment Configuration Template
# Copy this file to .env and provide your actual secrets.

# Groq API Key (Required for Whisper STT and GPT-OSS reasoning)
GROQ_API_KEY=gsk_your_groq_api_key_here

# PostgreSQL Database Connection String (Neon or local)
# Format: postgresql+asyncpg://user:password@host/dbname?ssl=require
DATABASE_URL=sqlite+aiosqlite:////tmp/responseos.db

# Cryptographically secure random session secret
SESSION_SECRET=replace_with_64_char_cryptographic_secret

# Application Environment (production / development)
ENVIRONMENT=production
PORT=8000
